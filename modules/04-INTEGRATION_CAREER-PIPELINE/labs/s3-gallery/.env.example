PORT=3000
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name

# OPTION A: LOCAL PROFILE (Uses ~/.aws/credentials)
# AWS_PROFILE=bootcamp

# OPTION B: HARDCODED ACCESS KEYS (Demo 1: Access Keys)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# OPTION C: IAM INSTANCE ROLE ON EC2 (Demo 2: Roles)
# If running on EC2 with an attached Instance Profile, leave both
# AWS_PROFILE and AWS_ACCESS_KEY_ID commented out. The SDK will auto-resolve credentials.

